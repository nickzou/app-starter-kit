{
  "extends": "@app-starter-kit/tsconfig/base.json",
  "compilerOptions": {
    "types": [],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Consumed as source (exports ./src), never emitted to .d.ts — and the tRPC
    // client's inferred types transitively reference the server's schema, which
    // isn't portable across the declaration boundary (TS2883). Disable emit.
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
